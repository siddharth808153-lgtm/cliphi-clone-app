# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Path to your cloned AI-Youtube-Shorts-Generator repo.
# Use forward slashes even on Windows, e.g. C:/Users/ASUS/New folder/AI-Youtube-Shorts-Generator
PYTHON_PROJECT_DIR=C:/path/to/AI-Youtube-Shorts-Generator
# Full path to the python.exe inside that project's venv, e.g.
# C:/path/to/AI-Youtube-Shorts-Generator/venv/Scripts/python.exe
PYTHON_BIN=python
LOCAL_OUTPUT_DIR=output

# Session (used to hold your YouTube OAuth tokens in memory for local single-user use)
SESSION_SECRET=change_this_to_any_random_string

# From Google Cloud Console — see README.md "YouTube API setup" section
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
